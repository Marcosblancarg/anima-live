<Window x:Class="src.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:src" Icon="Assets/Anima.ico" Title="Anima Live · 0.6 · Pads y música" Width="1120" Height="650" MinWidth="640" MinHeight="480" ResizeMode="CanResize" Background="#07070A" Foreground="#FAFAFF" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Window.Resources>
  <LinearGradientBrush x:Key="Brand" StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#9424F5" Offset="0"/><GradientStop Color="#6551F6" Offset="0.48"/><GradientStop Color="#11BDED" Offset="1"/></LinearGradientBrush>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F7F4FF"/><Setter Property="Background" Value="#1B1925"/><Setter Property="BorderBrush" Value="#393046"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource ActiveAccent}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#191721"/><Setter Property="Foreground" Value="#F7F4FF"/><Setter Property="CaretBrush" Value="#25C0F0"/><Setter Property="BorderBrush" Value="#36303F"/><Setter Property="Padding" Value="9,7"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#9B3DFF"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F7F4FF"/><Setter Property="Background" Value="#191721"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,7"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" Background="#191721" BorderBrush="#393043" BorderThickness="1" CornerRadius="4"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#B199DA" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#9650E9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,7,30,7" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"><Border Background="#191721" BorderBrush="#735191" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240" Padding="3"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F7F4FF"/><Setter Property="Padding" Value="9,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#43305C"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#312340"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Height" Value="22"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Border Height="3" Background="{StaticResource Brand}" VerticalAlignment="Center" CornerRadius="2"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="10" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#F8F4FF" BorderBrush="#A674EA" BorderThickness="1" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#BDB6CD"/><Setter Property="Margin" Value="0,10,0,0"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#9990AA"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,12,0,6"/></Style>

  <SolidColorBrush x:Key="ActiveAccent" Color="#A377FF"/>
  <LinearGradientBrush x:Key="MusicBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#102D1F"/><GradientStop Color="#080C0A" Offset=".6"/><GradientStop Color="#050706" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="MixerBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#351218"/><GradientStop Color="#10090B" Offset=".55"/><GradientStop Color="#080607" Offset="1"/></LinearGradientBrush>
  <Style x:Key="MusicButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#15291D"/><Setter Property="BorderBrush" Value="#315E43"/><Setter Property="Padding" Value="9,6"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
  <Style x:Key="MusicSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Border Height="3" Background="#47C877" VerticalAlignment="Center"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="10" Height="17" Background="#B0FFD1"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="VerticalFader" TargetType="Slider"><Setter Property="Orientation" Value="Vertical"/><Setter Property="Minimum" Value="-60"/><Setter Property="Maximum" Value="6"/><Setter Property="Value" Value="0"/><Setter Property="Width" Value="46"/><Setter Property="Height" Value="Auto"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" Margin="0,7"><Border Width="5" Background="#632833" CornerRadius="2" HorizontalAlignment="Center"/><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="38" Height="17"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#F3E3E6" BorderBrush="#FF6575" BorderThickness="1" CornerRadius="3"><Border Height="2" Background="#E34B61" VerticalAlignment="Center" Margin="5,0"/></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#12291D"/><Setter Property="Foreground" Value="#A5DDB7"/><Setter Property="BorderBrush" Value="#294735"/><Setter Property="Padding" Value="6,5"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  <Style TargetType="ListViewItem"><Setter Property="Foreground" Value="#DDEBE2"/><Setter Property="Padding" Value="4,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Row" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#1A2A20" Padding="{TemplateBinding Padding}"><GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#234930"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#54A96F"/></Trigger><DataTrigger Binding="{Binding Active}" Value="True"><Setter TargetName="Row" Property="Background" Value="#195032"/><Setter Property="Foreground" Value="#B7FFD0"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="5,7"/><Setter Property="Foreground" Value="#CADBD0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#20422D"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#4BA66B"/><Setter TargetName="Row" Property="BorderThickness" Value="0,0,0,1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

  <Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="#121318"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton x:Name="Less" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#55545F" CornerRadius="3" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="More" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Less" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="More" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid x:Name="LayoutRoot" Margin="12,8" Background="#07070A">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="20"/></Grid.RowDefinitions>
  <Grid x:Name="HeaderGrid" Margin="0,0,0,8">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="BrandPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
    <Grid Width="34" Height="34" Margin="0,0,10,0"><Path Data="M 0 33 L 17 0 L 34 33 L 26 33 L 17 14 L 8 33 Z" Fill="White"/><Path Data="M 12 33 L 17 23 L 22 33 Z" Fill="{StaticResource Brand}"/></Grid>
    <StackPanel><TextBlock Text="ANIMA" FontFamily="Segoe UI Black" FontStyle="Italic" FontSize="23" FontWeight="Black" LineHeight="24" LineStackingStrategy="BlockLineHeight"/><TextBlock Text="L I V E   P A D" FontSize="8" LineHeight="10" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="{StaticResource Brand}"/></StackPanel>
   </StackPanel>
   <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="⚙ Audio" Click="ShowAudioSettings" Padding="10,7"/>
    <Button x:Name="OpenBankButton" Content="Abrir banco" Click="OpenBank" Padding="10,7"/>
    <Button x:Name="SaveBankButton" Content="Guardar banco" Click="SaveBank" Background="#30203F" Padding="10,7"/>
    <CheckBox x:Name="DevicesToggle" Content="MIDI / salida" IsChecked="True" Click="ToggleDevices" VerticalAlignment="Center" Margin="6,0,14,0" FontSize="11" ToolTip="Mostrar u ocultar los dispositivos. La salida y el MIDI siguen funcionando al ocultarlos."/>
   </StackPanel>
   <TextBlock x:Name="ClockLabel" Grid.Column="2" Text="00:00:00" FontFamily="Consolas" FontSize="21" Foreground="#E4E9EB" VerticalAlignment="Center" Margin="8,0,12,0"/>
   <Button x:Name="ToolsButton" Grid.Column="3" Content="☰" ToolTip="Audio, bancos y dispositivos" Click="ToggleCompactTools" Padding="9,6" Visibility="Collapsed"/>
   <Button x:Name="PanicButton" Grid.Column="4" Content="■  DETENER TODO" Background="#22111D" BorderBrush="#663149" Foreground="#FFACC9" Click="Panic" Margin="0" Padding="12,9" VerticalAlignment="Center"/>
  </Grid>
  <Grid x:Name="DevicePanel" Grid.Row="1" Margin="0,0,0,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid x:Name="MidiGroup" Margin="0,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="MIDI" Foreground="#9995AC" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/><ComboBox x:Name="MidiDevices" Grid.Column="1" SelectionChanged="MidiChanged"/><Button Grid.Column="2" Content="↻" Margin="6,0,0,0" Padding="9,6" Click="RefreshDevices"/></Grid>
   <Grid x:Name="AudioGroup" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="SALIDA" Foreground="#9995AC" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11"/><ComboBox x:Name="AudioDevices" Grid.Column="1" SelectionChanged="AudioChanged"/></Grid>
  </Grid>
  <Grid x:Name="ModeTabs" Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Button x:Name="PadsTab" Content="▦  Pads" Tag="0" ToolTip="Pads · F5" Click="SelectMode" Padding="10,6" Background="#332044" BorderBrush="#9B61D9"/>
   <Button x:Name="PlayerTab" Grid.Column="1" Content="▶  Reproductor" Tag="1" ToolTip="Reproductor · F6" Click="SelectMode" Padding="10,6" Background="#10241A" BorderBrush="#295C3D"/>
   <Button x:Name="MixerTab" Grid.Column="2" Content="≋  Mixer" Tag="2" ToolTip="Mixer · F7" Click="SelectMode" Padding="10,6" Background="#2A1117" BorderBrush="#68333E" Margin="0"/>
  </Grid>
  <Grid x:Name="Workspace" Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition x:Name="MeterColumn" Width="100"/></Grid.ColumnDefinitions>
   <Grid x:Name="MainArea">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel x:Name="PadControls" Margin="0,0,0,4" VerticalAlignment="Center">
     <TextBlock x:Name="BankTitle" Text="MI BANCO" FontWeight="SemiBold" FontSize="11" MaxWidth="155" TextTrimming="CharacterEllipsis" Margin="0,0,18,6"/>
     <CheckBox x:Name="FollowMidi" IsChecked="True" Content="Seguir página" Margin="0,0,12,6" FontSize="11" ToolTip="Reconoce la página por las notas y canales recibidos."/>
     <CheckBox x:Name="PadFocus" Content="Pad Focus" IsChecked="True" Margin="0,0,12,6" FontSize="11" ToolTip="Selecciona en el editor el pad tocado por MIDI, aunque esté vacío."/>
     <CheckBox x:Name="EditorToggle" Content="Sample / editor" IsChecked="True" Margin="0,0,0,6" FontSize="11" Click="ToggleEditor"/>
    </WrapPanel>
    <UniformGrid x:Name="PageTabs" Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,6"/>
    <Grid x:Name="PadEditorArea" Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="EditorGap" Width="12"/><ColumnDefinition x:Name="EditorColumn" Width="280"/></Grid.ColumnDefinitions>
     <Grid x:Name="PadsPanel"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="PadScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="None"><UniformGrid x:Name="PadsGrid" Rows="4" Columns="4" MinHeight="256" Height="{Binding ActualHeight, ElementName=PadScroll}" Margin="0"/></ScrollViewer>
      <TextBlock x:Name="PadHint" Grid.Row="1" Text="Arrastrá audio · Clic derecho para editar · Esc detiene todo" Foreground="#8B819F" FontSize="10" TextTrimming="CharacterEllipsis" Margin="3,6,0,0"/>
     </Grid>
     <Border x:Name="EditorPanel" Grid.Column="2" Background="#101016" BorderBrush="#302338" BorderThickness="1" CornerRadius="8" Padding="12">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel>
        <Button x:Name="BackToPads" Content="← Pads" Click="BackToPadsClick" Visibility="Collapsed" DockPanel.Dock="Left" Padding="9,4" Margin="0,0,12,0"/>
        <TextBlock x:Name="PadNumber" Text="01" Foreground="#BE87FF" DockPanel.Dock="Right" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock Text="SAMPLE / EDITOR" Foreground="#9995AC" FontSize="10" VerticalAlignment="Center"/>
       </DockPanel>
       <ScrollViewer x:Name="EditorScroll" Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel>
         <TextBox x:Name="PadName" Margin="0,0,0,0" TextChanged="NameChanged" ToolTip="Nombre del pad"/>
         <TextBlock x:Name="FileLabel" Text="Sin audio" Foreground="#807B93" FontSize="10" Margin="0,6,0,8" TextTrimming="CharacterEllipsis"/>
         <Grid x:Name="EditorFields">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="EditorFieldsGap" Width="0"/><ColumnDefinition x:Name="PlaybackColumn" Width="0"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel x:Name="SampleGroup">
           <Border Background="#08080D" CornerRadius="5"><Canvas x:Name="Waveform" Height="80" Background="Transparent" ClipToBounds="True" SizeChanged="WaveSizeChanged" MouseLeftButtonDown="WaveClick" MouseMove="WaveMove" MouseLeftButtonUp="WaveRelease" LostMouseCapture="WaveLostCapture" ToolTip="Arrastrá los límites IN / OUT. Clic: inicio; Shift + clic: fin."/></Border>
           <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="INICIO · segundos" FontSize="9" Foreground="#9995AC"/><TextBox x:Name="StartBox" Margin="0,4,0,0" LostFocus="TrimChanged" KeyDown="TrimKey"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="FIN · segundos" FontSize="9" Foreground="#9995AC"/><TextBox x:Name="EndBox" Margin="0,4,0,0" LostFocus="TrimChanged" KeyDown="TrimKey"/></StackPanel></Grid>
           <Button Content="Aplicar cortes" Click="ApplyTrim" Padding="8,4" FontSize="10" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel x:Name="PlaybackGroup" Grid.Row="1" Margin="0,10,0,0">
           <DockPanel Margin="0,0,0,4"><TextBlock Text="GANANCIA" Foreground="#9995AC" FontSize="10"/><TextBlock x:Name="GainLabel" Text="0 dB" HorizontalAlignment="Right" Foreground="#22BCEA" FontSize="11"/></DockPanel><Slider x:Name="GainSlider" Minimum="-48" Maximum="12" Value="0" TickFrequency="1" ValueChanged="GainChanged"/>
           <TextBlock Text="MODO DE DISPARO" Style="{StaticResource Label}"/><ComboBox x:Name="ModeBox" SelectionChanged="ModeChanged"><ComboBoxItem Content="One Shot · hasta el final"/><ComboBoxItem Content="Normal · mantener"/><ComboBoxItem Content="Alternar · iniciar / parar"/></ComboBox>
           <CheckBox x:Name="VelocityBox" Content="Intensidad MIDI (velocity)" FontSize="11" Click="VelocityChanged"/>
          </StackPanel>
         </Grid>
         <Expander Header="MIDI, color y archivos" Foreground="#BDB6CD" FontSize="11" Margin="0,10,0,0">
          <StackPanel Margin="0,4,0,0">
           <TextBlock Text="ASIGNACIÓN MIDI" Style="{StaticResource Label}"/><DockPanel><Button x:Name="LearnButton" Content="Aprender" Click="Learn" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,6"/><TextBlock x:Name="MidiLabel" Text="Nota 36 · todos" VerticalAlignment="Center" Foreground="#C7CEDC" TextTrimming="CharacterEllipsis"/></DockPanel>
           <TextBlock Text="COLOR DEL PAD" Style="{StaticResource Label}"/><UniformGrid x:Name="Colors" Rows="1" Columns="6" Height="25"/>
           <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Cargar audio" Click="ChooseAudio" Padding="10,7"/><Button Content="Vaciar" Click="ClearPad" Margin="0" Padding="10,7"/></StackPanel>
           <CheckBox x:Name="LiveLock" Content="Bloquear edición para el vivo" Click="LockChanged"/>
          </StackPanel>
         </Expander>
        </StackPanel>
       </ScrollViewer>
      </Grid>
     </Border>
    </Grid>
   </Grid>
   <Border x:Name="PlayerPanel" Background="{StaticResource MusicBackground}" BorderBrush="#2A573C" BorderThickness="1" CornerRadius="8" Padding="10" Visibility="Collapsed">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="ExplorerColumn" Width="240"/><ColumnDefinition x:Name="ExplorerGap" Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid x:Name="ExplorerPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="AUDIO EXPLORER" FontSize="12" FontWeight="SemiBold" Foreground="#A1F5BA" Margin="0,0,0,8"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6"><Button Content="Carpetas" Click="ShowFolders" Style="{StaticResource MusicButton}"/><Button Content="Listas" Click="ShowPlaylists" Style="{StaticResource MusicButton}"/></StackPanel>
      <Grid Grid.Row="2" Margin="0,0,0,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="Carpeta…" Click="BrowseMusicFolder" Style="{StaticResource MusicButton}"/><Button Content="↑" Click="MusicFolderUp" Style="{StaticResource MusicButton}"/></StackPanel><TextBlock x:Name="ExplorerPath" Grid.Row="1" Text="Elegí una carpeta" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="#8DB49A" Margin="0,6,0,0"/></Grid>
      <ListBox x:Name="ExplorerList" Grid.Row="3" SelectionMode="Extended" Background="#090F0B" BorderBrush="#23402D" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ExplorerDoubleClick"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding Path}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
      <WrapPanel Grid.Row="4" Margin="0,7,0,0"><Button Content="Añadir selección →" Click="AddExplorerSelection" Style="{StaticResource MusicButton}"/><Button x:Name="BackToMusicButton" Content="← Main Music" Click="BackToMusic" Style="{StaticResource MusicButton}" Visibility="Collapsed"/></WrapPanel>
     </Grid>
     <Grid x:Name="MusicMain" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel x:Name="MusicHeading" Margin="0,0,0,6"><Button x:Name="ExplorerToggleButton" Content="☰ Explorer" Click="ToggleExplorer" DockPanel.Dock="Right" Style="{StaticResource MusicButton}" Margin="6,0,0,0"/><TextBlock Text="MAIN MUSIC" FontSize="13" FontWeight="SemiBold" Foreground="#B9FFD0" VerticalAlignment="Center"/></DockPanel>
      <Border x:Name="NowPlayingPanel" Grid.Row="1" Background="#0B1B11" BorderBrush="#264E34" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,6"><StackPanel><TextBlock x:Name="NowPlayingTitle" Text="Listo para reproducir" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,4,0,0"><TextBlock x:Name="MusicRemaining" Text="" Foreground="#69CF8E" DockPanel.Dock="Right" FontSize="11"/><TextBlock x:Name="MusicElapsed" Text="0:00 / 0:00" Foreground="#9BD6AB" FontFamily="Consolas" FontSize="11" DockPanel.Dock="Left"/><TextBlock x:Name="NextMusicLabel" Text="" Foreground="#80B590" FontSize="10" TextTrimming="CharacterEllipsis" Margin="10,0"/></DockPanel><Slider x:Name="MusicSeek" IsMoveToPointEnabled="True" Style="{StaticResource MusicSlider}" Minimum="0" Maximum="1" Value="0" PreviewMouseLeftButtonDown="SeekDown" PreviewMouseLeftButtonUp="SeekUp" PreviewKeyDown="SeekKey" ToolTip="Posición del tema"/></StackPanel></Border>
      <WrapPanel Grid.Row="2" Margin="0,0,0,6"><Button Content="▶ Play" Click="MusicPlay" Style="{StaticResource MusicButton}"/><Button x:Name="PauseMusicButton" Content="Ⅱ Pausa" Click="MusicPause" Style="{StaticResource MusicButton}"/><Button Content="■ Stop" Click="MusicStop" Style="{StaticResource MusicButton}"/><Button Content="▶|" ToolTip="Siguiente" Click="MusicNext" Style="{StaticResource MusicButton}"/><CheckBox x:Name="StopAfterBox" Content="Parar al terminar" Click="StopAfterChanged" Margin="3,6,0,0" FontSize="10"/></WrapPanel>
      <ListView x:Name="MusicQueue" Grid.Row="3" Background="#090F0B" BorderBrush="#254531" Foreground="#DDEBE2" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" DragOver="QueueDragOver" Drop="QueueDrop" MouseDoubleClick="QueueDoubleClick" SizeChanged="QueueSizeChanged" SelectionMode="Extended"><ListView.View><GridView><GridViewColumn Width="24" DisplayMemberBinding="{Binding Marker}"/><GridViewColumn x:Name="MusicTitleColumn" Header="Title" Width="260" DisplayMemberBinding="{Binding Title}"/><GridViewColumn Header="Length" Width="65" DisplayMemberBinding="{Binding Length}"/></GridView></ListView.View></ListView>
      <StackPanel Grid.Row="4" Margin="0,6,0,0">
       <WrapPanel><Button Content="＋ Audio" Click="AddMusicFiles" Style="{StaticResource MusicButton}"/><Button Content="Abrir lista" Click="OpenMusicList" Style="{StaticResource MusicButton}"/><Button Content="Guardar" Click="SaveMusicList" Style="{StaticResource MusicButton}"/><Button Content="↑" Click="MoveMusicUp" Style="{StaticResource MusicButton}"/><Button Content="↓" Click="MoveMusicDown" Style="{StaticResource MusicButton}"/><Button Content="Quitar" Click="RemoveMusic" Style="{StaticResource MusicButton}"/></WrapPanel>
       <DockPanel Margin="0,5,0,0">
        <Button x:Name="PlayerOptionsButton" Content="⚙ Crossfade / Cue" Click="OpenPlayerOptions" Style="{StaticResource MusicButton}" DockPanel.Dock="Left"/>
        <CheckBox x:Name="RepeatMusicBox" Content="Repetir lista" Click="RepeatMusicChanged" Margin="6,7,8,0" FontSize="10" DockPanel.Dock="Left"/>
        <TextBlock x:Name="QueueSummary" Text="0 temas" FontSize="10" Foreground="#8CB69A" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
       </DockPanel>
       <Popup x:Name="PlayerOptionsPopup" Placement="Top" PlacementTarget="{Binding ElementName=PlayerOptionsButton}" StaysOpen="False" AllowsTransparency="True">
        <Border Background="#102019" BorderBrush="#497B59" BorderThickness="1" CornerRadius="6" Padding="14" Width="330"><StackPanel>
         <DockPanel Margin="0,0,0,10"><TextBlock Text="Crossfade entre temas" VerticalAlignment="Center"/><ComboBox x:Name="CrossfadeBox" Width="75" HorizontalAlignment="Right" SelectionChanged="CrossfadeChanged"><ComboBoxItem Content="0 s"/><ComboBoxItem Content="1 s"/><ComboBoxItem Content="2 s"/><ComboBoxItem Content="3 s"/><ComboBoxItem Content="5 s"/></ComboBox></DockPanel>
         <TextBlock Text="Preescucha · salida independiente" Foreground="#A1D8B2" FontSize="11"/><ComboBox x:Name="CueDevices" Margin="0,6,0,8"/>
         <WrapPanel><Button Content="◉ Preescuchar" Click="PlayCue" Style="{StaticResource MusicButton}"/><Button Content="■ Cue" Click="StopCue" Style="{StaticResource MusicButton}"/></WrapPanel>
        </StackPanel></Border>
       </Popup>
      </StackPanel>
     </Grid>
    </Grid>
   </Border>
   <Border x:Name="MixerPanel" Background="{StaticResource MixerBackground}" BorderBrush="#6A2F3D" BorderThickness="1" CornerRadius="8" Padding="10" Visibility="Collapsed">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="MIXER · PADS + MÚSICA" Foreground="#FFB0BC" FontSize="12" FontWeight="SemiBold" Margin="3,0,0,8"/>
     <UniformGrid Grid.Row="1" Rows="1" Columns="2">
      <Border Background="#160D10" BorderBrush="#6A2E3D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,6"><TextBlock Text="PADS" FontSize="14" FontWeight="SemiBold" Foreground="#FFD4DC"/><TextBlock x:Name="PadFaderLabel" Text="0.0 dB" FontSize="11" Foreground="#FF8099" HorizontalAlignment="Right"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><local:OutputMeter x:Name="PadChannelMeter" Width="94" Caption="PADS" Footer="TODAS LAS PÁGINAS" PositionLabel="POST FADER" LowColor="#ED526B"/><Slider x:Name="PadFader" Grid.Column="1" Style="{StaticResource VerticalFader}" ValueChanged="PadFaderChanged" MouseDoubleClick="ResetFader" ToolTip="Volumen de pads · doble clic: 0 dB"/></Grid><CheckBox x:Name="PadMute" Grid.Row="2" Content="MUTE" Click="MixerMuteChanged" Margin="0,7,0,0" Foreground="#FFB9C5"/></Grid></Border>
      <Border Background="#160D10" BorderBrush="#6A2E3D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,6"><TextBlock Text="MÚSICA" FontSize="14" FontWeight="SemiBold" Foreground="#FFD4DC"/><TextBlock x:Name="MusicFaderLabel" Text="0.0 dB" FontSize="11" Foreground="#FF8099" HorizontalAlignment="Right"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><local:OutputMeter x:Name="MusicChannelMeter" Width="94" Caption="MÚSICA" Footer="CORTINA / ESPERA" PositionLabel="POST FADER" LowColor="#ED526B"/><Slider x:Name="MusicFader" Grid.Column="1" Style="{StaticResource VerticalFader}" ValueChanged="MusicFaderChanged" MouseDoubleClick="ResetFader" ToolTip="Volumen de música · doble clic: 0 dB"/></Grid><CheckBox x:Name="MusicMute" Grid.Row="2" Content="MUTE" Click="MixerMuteChanged" Margin="0,7,0,0" Foreground="#FFB9C5"/></Grid></Border>
     </UniformGrid>
     <CheckBox x:Name="DuckMusicBox" Grid.Row="2" Content="Bajar música al disparar pads (−12 dB)" Click="DuckMusicChanged" Foreground="#E6A8B6" FontSize="11" Margin="3,9,0,0"/>
    </Grid>
   </Border>
   <Border x:Name="MeterPanel" Grid.Column="2" Background="#101016" BorderBrush="#302338" BorderThickness="1" CornerRadius="8" Padding="5,10,5,9">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <local:OutputMeter x:Name="MixMeter"/>
     <StackPanel Grid.Row="1" Margin="4,10,4,0"><TextBlock Text="VOLUMEN" Foreground="#9995AC" FontSize="9"/><TextBlock x:Name="PeakLabel" Text="−3 dB" Foreground="#22BCEA" FontSize="10" TextTrimming="CharacterEllipsis"/><Slider x:Name="MasterSlider" Minimum="0" Maximum="1" Value="0.7" ValueChanged="MasterChanged" Margin="0,4,0,0" ToolTip="Volumen master"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
  <TextBlock x:Name="Status" Grid.Row="4" Text="Listo para cargar tu primer sonido." Foreground="#9995AC" FontSize="10" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
 </Grid>
</Window>
